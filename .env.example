#--------------------------------------------------------------------------
# Application
#--------------------------------------------------------------------------
APP_NAME="Annuaire"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Casablanca

# fr is the default public locale. Missing framework strings fall back to en.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#--------------------------------------------------------------------------
# Directory
#--------------------------------------------------------------------------
# Slug of the launch city ("/" redirects there). Must exist in database/seeders/data/city.json.
DIRECTORY_DEFAULT_CITY=ma-ville
# CNDP declaration/authorization number shown in the footer (Law 09-08). Leave empty until obtained.
CNDP_NUMBER=

# Map tiles. Public OSM tiles are NOT allowed for production traffic:
# use MapTiler, Stadia Maps, etc. before launch (keep the attribution their terms require).
MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"
MAP_MAX_ZOOM=19

#--------------------------------------------------------------------------
# Ranking (see config/ranking.php). Paid plans never influence these.
#--------------------------------------------------------------------------
RANKING_BAYESIAN_M=5
RANKING_FALLBACK_AVERAGE=3.5
RANKING_WEIGHT_BAYESIAN=0.40
RANKING_WEIGHT_TEXT=0.25
RANKING_WEIGHT_DISTANCE=0.15
RANKING_WEIGHT_COMPLETENESS=0.08
RANKING_WEIGHT_RECENCY=0.07
RANKING_WEIGHT_VERIFIED=0.05
RANKING_DISTANCE_HORIZON_KM=10
RANKING_RECENCY_HORIZON_DAYS=365

#--------------------------------------------------------------------------
# Authentication
#--------------------------------------------------------------------------
# OTP driver: log (development: code written to storage/logs), sms, whatsapp.
OTP_DRIVER=log
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Code requests per phone (15 min), per phone per day, per IP (1 h); verifications per phone (15 min).
OTP_LIMIT_PER_PHONE=3
OTP_LIMIT_PER_PHONE_DAILY=10
OTP_LIMIT_PER_IP=10
OTP_VERIFY_LIMIT_PER_PHONE=10

# SMS provider (to be chosen).
OTP_SMS_PROVIDER=
OTP_SMS_API_KEY=
OTP_SMS_SENDER=

# WhatsApp Business provider (to be chosen), authentication template.
OTP_WHATSAPP_PROVIDER=
OTP_WHATSAPP_API_KEY=
OTP_WHATSAPP_PHONE_NUMBER_ID=
OTP_WHATSAPP_TEMPLATE=

# Optional login methods (phone + OTP is always on).
AUTH_EMAIL_PASSWORD_ENABLED=false
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register "${APP_URL}/auth/google/callback" in the Google console.
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

#--------------------------------------------------------------------------
# Database (MySQL 8 with spatial support). Values below match Laravel Sail.
#--------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

#--------------------------------------------------------------------------
# Cache, sessions, queues: Redis (Horizon monitors the queues at /horizon)
#--------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

#--------------------------------------------------------------------------
# Search (Laravel Scout + Meilisearch)
#--------------------------------------------------------------------------
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=
MEILISEARCH_NO_ANALYTICS=true

#--------------------------------------------------------------------------
# Mail (Mailpit in development: http://localhost:8025)
#--------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@example.com"
MAIL_FROM_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# Media storage (optional S3-compatible offsite storage)
#--------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# Laravel Sail
#--------------------------------------------------------------------------
APP_PORT=80
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
FORWARD_MEILISEARCH_PORT=7700
WWWGROUP=1000
WWWUSER=1000
